.venv/
__pycache__/
*.pyc
*.log

# Model weights (downloaded on first run)
models/*.pt
models/roboflow_*/
/yolo11*.pt

# Exported ONNX model for the browser's client-side vector scan (regenerate
# with `python -m pos_app.export_onnx`)
static/embedder.onnx

# Generated outputs
outputs/annotated/*
outputs/crops/*
outputs/json/*
!outputs/annotated/.gitkeep
!outputs/crops/.gitkeep
!outputs/json/.gitkeep

uploads/*
!uploads/.gitkeep

# POS onboarding dataset (captured images, catalog, and generated YOLO dataset)
dataset/images/*
dataset/yolo/
dataset/products.json
dataset/embeddings.npz
models/pos_finetune/
models/pos_custom.pt

# POS completed-order receipts
orders/*.json

# Background training job logs (started by the browser UI's /train-model, or ad-hoc runs)
*training_log.txt
